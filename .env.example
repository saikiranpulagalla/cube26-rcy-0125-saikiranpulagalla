# Local/demo-only values. Copy to an uncommitted .env and replace every password.
RECOVERY_ADMIN_DB_PASSWORD=replace-with-local-admin-password
RECOVERY_OWNER_DB_PASSWORD=replace-with-local-owner-password
RECOVERY_APP_DB_PASSWORD=replace-with-local-app-password
RECOVERY_WORKER_DB_PASSWORD=replace-with-local-worker-password
RECOVERY_DATABASE_URL=postgresql+psycopg://recovery_app:replace-with-local-app-password@localhost:5432/recovery
RECOVERY_MIGRATION_DATABASE_URL=postgresql+psycopg://recovery_owner:replace-with-local-owner-password@localhost:5432/recovery
RECOVERY_WORKER_DATABASE_URL=postgresql+psycopg://recovery_worker:replace-with-local-worker-password@localhost:5432/recovery
RECOVERY_DATABASE_REQUIRED=true
# Required before demo/evaluate may create controlled synthetic state. Keep this
# true only for an isolated local/test database with the three roles above.
RECOVERY_BENCHMARK_DATABASE=false
RECOVERY_MAX_INPUT_BYTES=1048576
RECOVERY_DEMO_FIXTURES_ENABLED=false
RECOVERY_DEVELOPMENT_MODE=true
RECOVERY_WORKER_MAX_ATTEMPTS=3
RECOVERY_LEASE_SECONDS=30
# This explicit local/demo mapping is not a real identity provider and has no production credentials.
RECOVERY_DEV_CREDENTIALS={"alpha-local-token":{"org_id":"org_demo_alpha","actor_id":"operator_alpha","role":"operator"},"bravo-local-token":{"org_id":"org_demo_bravo","actor_id":"operator_bravo","role":"operator"}}
